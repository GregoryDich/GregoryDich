# Скопируй в .env и заполни. Файл .env в .gitignore — ключи не попадут в git.

# --- Данные ---
# FRED API key (необязательно: без ключа используется публичный fredgraph.csv)
FRED_API_KEY=

# --- Алерты и дайджест ---
# Telegram-бот: создай через @BotFather, chat_id узнай через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy — резервный push-канал (если Telegram недоступен/угнан).
# Подпишись на топик в приложении ntfy: https://ntfy.sh/<твой-секретный-топик>
NTFY_TOPIC=

# Час утреннего дайджеста (Asia/Jerusalem)
DIGEST_HOUR=7
DIGEST_MINUTE=30

# --- ИИ-копайлот (Фаза 2) ---
ANTHROPIC_API_KEY=

# --- Пути ---
# Каталог локальных данных (DuckDB, профиль). По умолчанию jarvis/data
# JARVIS_DATA_DIR=/абсолютный/путь
