{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "SendUserFile",
      "Artifact",
      "mcp__Figma__create_session",
      "mcp__Figma__use_figma",
      "mcp__Figma__get_screenshot",
      "mcp__Figma__get_metadata",
      "mcp__Figma__download_assets",
      "mcp__Figma__upload_assets",
      "mcp__Higgsfield__balance",
      "mcp__Higgsfield__transactions",
      "mcp__Higgsfield__models_explore",
      "mcp__Higgsfield__estimate_image_cost",
      "mcp__Higgsfield__estimate_video_cost",
      "mcp__Higgsfield__jobs_wait",
      "mcp__Higgsfield__show_generation_by_ids",
      "mcp__Higgsfield__media_import_url",
      "mcp__Higgsfield__media_upload",
      "mcp__Higgsfield__media_confirm",
      "mcp__Higgsfield__get_workflow_instructions",
      "mcp__Higgsfield__get_workflow_bundle_file",
      "mcp__Higgsfield__get_preset_instructions",
      "mcp__Higgsfield__generate_image",
      "mcp__Higgsfield__generate_image_batch",
      "mcp__Claude_Code_Remote__report_preview_port",
      "mcp__Higgsfield__generate_video",
      "mcp__Higgsfield__generate_video_batch",
      "mcp__Higgsfield__show_generations",
      "mcp__Vercel__list_teams",
      "mcp__Vercel__git_namespaces",
      "mcp__Vercel__search_repo",
      "mcp__Vercel__list_projects",
      "mcp__Vercel__get_project",
      "mcp__Vercel__get_deployment",
      "mcp__Vercel__list_deployments",
      "mcp__Vercel__list_deployment_events",
      "mcp__Vercel__get_auth_user"
    ],
    "ask": [
      "mcp__atlascloud"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/mitoderm-catalog/PROGRESS.md\"; [ -f \"$f\" ] && sed -n '1,/^## Деньги/p' \"$f\" || true"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && d=\"${CLAUDE_PROJECT_DIR:-.}/mitoderm-catalog/codex-site\" && [ -d \"$d/dist\" ] && ! pgrep -f '[w]orkerd' >/dev/null 2>&1 && (cd \"$d\" && setsid nohup corepack pnpm start >/tmp/mitoderm-preview.log 2>&1 </dev/null &); true"
          }
        ]
      }
    ]
  }
}
