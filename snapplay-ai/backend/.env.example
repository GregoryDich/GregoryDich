# Copy to .env for local development. Never commit .env.
ENV=development

# --- Supabase (auth + Postgres via PostgREST) ---
# Leave SUPABASE_URL empty (or set ENV=test) to run entirely on the in-memory backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# The anon key is only used by the /v1/auth/* GoTrue proxy.
SUPABASE_ANON_KEY=replace-me
# JWT verification: HS256 with the project secret OR RS256/ES256 via JWKS (set at least one).
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWKS_URL=

# --- Storage: supabase | s3 | memory ---
STORAGE_BACKEND=memory
STORAGE_BUCKET=jobs
SIGNED_URL_TTL_SECONDS=86400

# --- AWS production path (STORAGE_BACKEND=s3, SNAPPLAY_PIPELINE=aws) ---
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
SQS_JOB_QUEUE_URL=
SQS_DLQ_URL=
JOB_TIMEOUT_SECONDS=180

# --- Payment webhooks ---
LEMONSQUEEZY_WEBHOOK_SECRET=replace-me
PADDLE_WEBHOOK_SECRET=replace-me
# How long a claimed but unfinished delivery blocks its own retries. A process killed
# mid-apply leaves the claim behind; past this lease the provider's retry takes it over.
# Keep it above the longest an apply can take and below the provider's retry window.
WEBHOOK_CLAIM_LEASE_SECONDS=300

# --- Pipeline: fake | local | modal | runpod | aws ---
# fake/local run in the API process (job events use the in-process bus); modal, runpod and
# aws hand the job to a remote worker and the event stream falls back to polling the row.
SNAPPLAY_PIPELINE=fake
MODAL_APP_NAME=snapplay-worker
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# --- Limits and product rules (rate limits are per authenticated principal) ---
MAX_UPLOAD_BYTES=10485760
MAX_INPUT_SECONDS=60
FREE_SIGNUP_CREDITS=3
RATE_LIMIT_JOBS_PER_MIN=10
RATE_LIMIT_READS_PER_MIN=60
AFFILIATE_COMMISSION_RATE=0.30

# Comma-separated browser origins allowed by CORS ("*" for any).
CORS_ALLOW_ORIGINS=*
