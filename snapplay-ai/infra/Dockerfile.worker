# syntax=docker/dockerfile:1.7
# GPU worker image for ECS (SQS consumer) and RunPod serverless.
# Build context is the snapplay-ai/ directory:
#   docker build -f infra/Dockerfile.worker -t snapplay-worker .
#   docker build -f infra/Dockerfile.worker --build-arg INSTALL_WORKER_SDKS= .   # ECS-only, no runpod/modal
#
# GPU stack (backend/requirements-gpu.txt), pinned for this CUDA 12.4.1 / cuDNN 9 base:
#   torch 2.6.0+cu124 + torchaudio 2.6.0+cu124  (download.pytorch.org/whl/cu124)
#   onnxruntime-gpu 1.20.2                       (CUDA 12.x / cuDNN 9 build on PyPI)
#   demucs 4.0.1, basic-pitch 0.4.0 (--no-deps: its Linux default backend is TensorFlow;
#   the bundled ONNX model runs on onnxruntime-gpu, see app/pipeline/transcription.py)
# No compiler is installed: every dependency ships a cp311 manylinux wheel (lameenc
# included) or is a pure-Python sdist (julius, dora-search, pretty_midi).
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ARG INSTALL_WORKER_SDKS=1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Ubuntu 22.04 ships Python 3.10; 3.11 comes from the deadsnakes PPA.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gnupg software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv \
        ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

RUN groupadd --system --gid 10001 worker \
    && useradd --system --uid 10001 --gid worker --create-home --home-dir /home/worker --shell /usr/sbin/nologin worker

WORKDIR /app

COPY backend/requirements.txt backend/requirements-gpu.txt backend/requirements-workers.txt ./
RUN pip install --no-cache-dir "pip==24.3.1" \
    && pip install --no-cache-dir -r requirements.txt -r requirements-gpu.txt \
    && pip install --no-cache-dir --no-deps "basic-pitch==0.4.0" \
    && if [ -n "$INSTALL_WORKER_SDKS" ]; then pip install --no-cache-dir -r requirements-workers.txt; fi

# Build-time smoke check: the stack imports, the ONNX checkpoint is present and the
# CUDA execution provider is compiled into onnxruntime (no GPU is needed for either).
RUN python -c "import torch, demucs, basic_pitch; print(torch.__version__)" \
    && python -c "import onnxruntime as ort, torch; from basic_pitch import FilenameSuffix, build_icassp_2022_model_path; assert build_icassp_2022_model_path(FilenameSuffix.onnx).is_file(); assert 'CUDAExecutionProvider' in ort.get_available_providers(); print('torch cuda', torch.version.cuda, 'onnxruntime', ort.__version__)"

COPY --chown=worker:worker backend/ /app/
COPY --chmod=0755 infra/worker-entrypoint.sh /usr/local/bin/worker-entrypoint

USER worker

# Model weights (Demucs, Basic Pitch) are cached under the worker's home so a
# persistent volume can be mounted there to skip re-downloads. SERVICE_ROLE tells the
# shared Settings that this process is a worker, not the API.
ENV HOME=/home/worker \
    TORCH_HOME=/home/worker/.cache/torch \
    SERVICE_ROLE=worker \
    WORKER_MODE=aws

ENTRYPOINT ["worker-entrypoint"]
