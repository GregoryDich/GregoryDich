# Single source of product identity for plugin/packaging/** and .github/workflows/release.yml.
#
# Every packaging script, the installer scripts and the release workflow read these values;
# nothing else in packaging/ may hard-code the product name. Populated from CMakeLists.txt
# (juce_add_plugin) - keep the two in sync until the CMake side reads this file too.
#
# Format rules (bash `source` and windows/Common.ps1 both parse it):
#   KEY="value"            one assignment per line, always double-quoted
#   KEY="${OTHER_KEY}"     may reference a key defined above it
#   # ...                  comments (whole line or after the value) are ignored

PRODUCT_NAME="SnapPlay AI"                 # juce_add_plugin PRODUCT_NAME: bundle and file names on disk
PRODUCT_SLUG="SnapPlayAI"                  # no spaces: release asset file names
BUNDLE_ID_BASE="ai.snapplay.plugin"        # juce_add_plugin BUNDLE_ID: pkg/Inno identifiers derive from it
VENDOR_NAME="SnapPlay"                     # juce_add_plugin COMPANY_NAME
VENDOR_URL="https://snapplay.ai"           # juce_add_plugin COMPANY_WEBSITE
PLUGIN_MANUFACTURER_CODE="Snpl"            # juce_add_plugin PLUGIN_MANUFACTURER_CODE (4 chars)
PLUGIN_CODE="Snap"                         # juce_add_plugin PLUGIN_CODE (4 chars)
AU_TYPE="aumu"                             # AU_MAIN_TYPE kAudioUnitType_MusicDevice
AU_SUBTYPE="${PLUGIN_CODE}"                # auval -v <AU_TYPE> <AU_SUBTYPE> <AU_MANUFACTURER>
AU_MANUFACTURER="${PLUGIN_MANUFACTURER_CODE}"
MIN_MACOS="11.0"                           # CMAKE_OSX_DEPLOYMENT_TARGET and the pkg's allowed-os-versions
COPYRIGHT_HOLDER="${VENDOR_NAME}"          # replace with the registered legal entity before the first public release
CMAKE_TARGET="SnapPlayAI"                  # juce_add_plugin target: <target>_VST3, <target>_AU, <target>_artefacts/
CMAKE_OPTION_PREFIX="SNAPPLAY"             # <prefix>_VERSION and <prefix>_USE_RUBBERBAND cache variables
