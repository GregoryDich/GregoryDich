# Copy to .env for local development. Never commit .env.
ENV=development
# api | worker — the GPU worker skips the production checks for webhook secrets and AUTH_SITE_URL.
SERVICE_ROLE=api

# --- Supabase (auth + Postgres via PostgREST) ---
# Leave SUPABASE_URL empty (or set ENV=test) to run entirely on the in-memory backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# The anon key is only used by the /v1/auth/* GoTrue proxy.
SUPABASE_ANON_KEY=replace-me
# JWT verification: HS256 with the project secret OR RS256/ES256 via JWKS (set at least one).
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWKS_URL=
# Website the confirmation / password-recovery emails link back to: sign-up and resend use
# <AUTH_SITE_URL>/auth/confirm, recovery uses <AUTH_SITE_URL>/auth/reset-password. Add both
# to the Supabase Auth redirect allow-list, or GoTrue silently uses its own site URL instead.
AUTH_SITE_URL=http://localhost:3000

# --- Storage: supabase | s3 | memory ---
STORAGE_BACKEND=memory
STORAGE_BUCKET=jobs
SIGNED_URL_TTL_SECONDS=86400

# --- AWS production path (STORAGE_BACKEND=s3, TONAMORPH_PIPELINE=aws) ---
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
SQS_JOB_QUEUE_URL=
SQS_DLQ_URL=
JOB_TIMEOUT_SECONDS=180

# --- Payment webhooks (production needs at least one; a provider left empty answers 404) ---
LEMONSQUEEZY_WEBHOOK_SECRET=replace-me
PADDLE_WEBHOOK_SECRET=replace-me
# How long a claimed but unfinished delivery blocks its own retries. A process killed
# mid-apply leaves the claim behind; past this lease the provider's retry takes it over.
# Keep it above the longest an apply can take and below the provider's retry window.
WEBHOOK_CLAIM_LEASE_SECONDS=300

# --- Pipeline: fake | local | modal | runpod | aws ---
# fake/local run in the API process (job events use the in-process bus); modal, runpod and
# aws hand the job to a remote worker and the event stream falls back to polling the row.
TONAMORPH_PIPELINE=fake
MODAL_APP_NAME=tonamorph-worker
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# Separation model loaded by the GPU worker (app/pipeline/separation.py SEPARATION_MODELS).
# htdemucs* weights are research-only: with ENV=production the worker refuses to start
# unless SEPARATION_MODEL names a commercially licensed model or, for internal testing,
# ALLOW_UNLICENSED_SEPARATION_MODEL=1 is set.
SEPARATION_MODEL=htdemucs
ALLOW_UNLICENSED_SEPARATION_MODEL=

# --- Limits and product rules (rate limits are per authenticated principal) ---
MAX_UPLOAD_BYTES=10485760
MAX_INPUT_SECONDS=60
FREE_SIGNUP_CREDITS=3
RATE_LIMIT_JOBS_PER_MIN=10
RATE_LIMIT_READS_PER_MIN=60
AFFILIATE_COMMISSION_RATE=0.30
# true refuses new jobs with 503 service_unavailable (Retry-After: 300); every other route keeps working.
MAINTENANCE_MODE=false

# Sentry DSN (https://…@…ingest.sentry.io/…); empty disables error reporting. Events are
# scrubbed of headers, cookies, bodies and query strings before they leave the process.
SENTRY_DSN=

# Comma-separated browser origins allowed by CORS ("*" for any).
CORS_ALLOW_ORIGINS=*

# --- Growth events (contract §14): Klaviyo receives Signed Up, Morph Completed, ... server-side.
# Empty disables emission. The GPU worker needs the same key: Morph Completed / Morph Failed
# leave from whichever process finishes the job. Never logged.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_TIMEOUT_SECONDS=5

# --- Plugin release channel served by GET /v1/version (contract §14); download and release
# notes links are <AUTH_SITE_URL>/download and <AUTH_SITE_URL>/changelog.
PLUGIN_LATEST_VERSION=0.1.0
PLUGIN_MIN_SUPPORTED_VERSION=0.1.0
