{
  "product_name": "Tonamorph",
  "site_url": "https://tonamorph.com",
  "from_email": "support@tonamorph.com",
  "from_label": "Tonamorph",
  "reply_to": "support@tonamorph.com",
  "utm": {
    "source": "klaviyo",
    "medium": "email",
    "campaign": "the flow slug (utm_campaign below)",
    "content": "the template slug"
  },
  "lists": ["Tonamorph users", "Tonamorph newsletter", "Tonamorph waitlist"],
  "segments": {
    "Activated": "Morph Completed at least once",
    "Free no morph 48h": "Signed Up over 48 h ago, plan = free, no Morph Completed",
    "Paying": "plan is not free",
    "Dormant 30d": "Signed Up over 30 d ago, no Morph Completed and no Purchase Completed in 30 d, no Refund Issued"
  },
  "metrics_source": "names: backend/app/services/klaviyo.py METRICS; properties: backend/app/services/growth.py and docs/API_CONTRACT.md section 14",
  "metrics": {
    "Signed Up": ["user_id", "source", "referral_code", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "marketing_opt_in"],
    "Plugin Installed": ["os", "daw", "plugin_version"],
    "Morph Completed": ["job_id", "latency_ms", "credits_charged", "balance_after", "morphs_total", "bpm", "key"],
    "Morph Failed": ["job_id", "error_code", "stage", "latency_ms"],
    "Credits Exhausted": ["plan", "checkout_url_pack_50", "checkout_url_sub_monthly"],
    "Checkout Started": ["plan_id", "ref"],
    "Purchase Completed": ["plan_id", "price_usd", "credits", "is_renewal", "referral_code"],
    "Subscription Cancelled": ["plan_id", "period_end"],
    "Refund Issued": ["amount_usd", "reason", "credits_removed", "commission_voided"],
    "NPS Submitted": ["score", "comment"],
    "Referral Joined": ["friend_user_id", "source", "bonus_credits"],
    "Referral Rewarded": ["friend_user_id", "credits"],
    "Gift Granted": ["gift", "credits"]
  },
  "profile_properties": [
    "signup_source", "referral_code", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term",
    "marketing_opt_in", "plan", "cohort_week", "os", "daw", "plugin_version",
    "morphs_total", "first_morph_at", "last_morph_at", "credits_available", "nps_score"
  ],
  "globals": ["organization.name", "organization.full_address", "unsubscribe_link"],
  "tags": ["unsubscribe", "if", "elif", "else", "endif"],
  "filters": ["default", "lookup", "floatformat"],
  "templates": [
    {
      "slug": "welcome-0h",
      "file": "templates/welcome-0h.html",
      "text_file": "templates/welcome-0h.txt",
      "klaviyo_name": "Tonamorph - Welcome 1 - 0 h",
      "subject": "Your 3 morphs are ready",
      "preview_text": "No card. Drop any clip up to 60 s.",
      "kind": "flow",
      "flow": "Welcome",
      "step": 1,
      "trigger_metric": "Signed Up",
      "trigger_note": "GTM Appendix C section 4 triggers Welcome on 'Added to list: Tonamorph users'. The backend emits Signed Up at that moment and does not add profiles to lists yet, so the metric is the trigger that works today; switch to the list trigger once the list add is wired.",
      "delay": "PT0S",
      "delay_label": "0 h",
      "filter": null,
      "transactional": false,
      "utm_campaign": "welcome",
      "event_variables": [],
      "profile_variables": []
    },
    {
      "slug": "welcome-2d",
      "file": "templates/welcome-2d.html",
      "text_file": "templates/welcome-2d.txt",
      "klaviyo_name": "Tonamorph - Welcome 2 - +2 d",
      "subject": "Drop any track",
      "preview_text": "Up to 60 seconds. One loop is enough.",
      "kind": "flow",
      "flow": "Welcome",
      "step": 2,
      "trigger_metric": "Signed Up",
      "delay": "P2D",
      "delay_label": "+2 d",
      "filter": "Conditional split before send: profile morphs_total is not set or equals 0 (no Morph Completed since entering the flow); otherwise skip",
      "transactional": false,
      "utm_campaign": "welcome",
      "event_variables": [],
      "profile_variables": []
    },
    {
      "slug": "welcome-5d",
      "file": "templates/welcome-5d.html",
      "text_file": "templates/welcome-5d.txt",
      "klaviyo_name": "Tonamorph - Welcome 3 - +5 d",
      "subject": "Three loops producers morph first",
      "preview_text": "An 808 from a guitar. Vocals as a pad. Drums on keys.",
      "kind": "flow",
      "flow": "Welcome",
      "step": 3,
      "trigger_metric": "Signed Up",
      "delay": "P5D",
      "delay_label": "+5 d",
      "filter": "Conditional split before send: profile morphs_total is not set or equals 0; otherwise skip",
      "transactional": false,
      "utm_campaign": "welcome",
      "event_variables": [],
      "profile_variables": []
    },
    {
      "slug": "first-morph-success",
      "file": "templates/first-morph-success.html",
      "text_file": "templates/first-morph-success.txt",
      "klaviyo_name": "Tonamorph - First morph - +30 min",
      "subject": "It's on your keys",
      "preview_text": "Now drag the MIDI out.",
      "kind": "flow",
      "flow": "First morph",
      "step": 1,
      "trigger_metric": "Morph Completed",
      "delay": "PT30M",
      "delay_label": "+30 min",
      "filter": "Trigger filter: event morphs_total equals 1",
      "transactional": false,
      "utm_campaign": "first-morph",
      "event_variables": ["key", "bpm", "balance_after"],
      "profile_variables": []
    },
    {
      "slug": "first-morph-failure",
      "file": "templates/first-morph-failure.html",
      "text_file": "templates/first-morph-failure.txt",
      "klaviyo_name": "Tonamorph - Failed morph - +20 min (transactional)",
      "subject": "That one didn't cost a morph",
      "preview_text": "What usually fixes it.",
      "kind": "flow",
      "flow": "Failed morph",
      "step": 1,
      "trigger_metric": "Morph Failed",
      "delay": "PT20M",
      "delay_label": "+20 min",
      "filter": "Conditional split before send: Morph Completed at least once in the last 1 hour -> exit. Message marked transactional in the UI, smart sending off",
      "transactional": true,
      "utm_campaign": "failed-morph",
      "event_variables": ["error_code", "stage"],
      "profile_variables": ["credits_available"]
    },
    {
      "slug": "credits-at-zero",
      "file": "templates/credits-at-zero.html",
      "text_file": "templates/credits-at-zero.txt",
      "klaviyo_name": "Tonamorph - Zero credits - 0 h",
      "subject": "3 morphs down. Your MIDI stays.",
      "preview_text": "50 for $9, or 60 a month.",
      "kind": "flow",
      "flow": "Zero credits",
      "step": 1,
      "trigger_metric": "Credits Exhausted",
      "delay": "PT0S",
      "delay_label": "0 h",
      "filter": "Trigger filter: event plan equals free. Flow filter: has not Purchase Completed since entering the flow (exit on purchase)",
      "transactional": false,
      "utm_campaign": "zero-credits",
      "event_variables": ["checkout_url_pack_50", "checkout_url_sub_monthly"],
      "profile_variables": []
    },
    {
      "slug": "day-7-nudge",
      "file": "templates/day-7-nudge.html",
      "text_file": "templates/day-7-nudge.txt",
      "klaviyo_name": "Tonamorph - Day 7 - no morph yet",
      "subject": "Still have 3 free morphs",
      "preview_text": "One loop is enough to know.",
      "kind": "flow",
      "flow": "Day-7",
      "step": 1,
      "trigger_metric": "Signed Up",
      "delay": "P7D",
      "delay_label": "+7 d",
      "filter": "Conditional split: profile morphs_total is not set or equals 0 -> this message; morphs_total >= 1 and plan = free -> paid-features step (not authored here); plan is not free -> exit",
      "transactional": false,
      "utm_campaign": "day-7",
      "event_variables": [],
      "profile_variables": []
    },
    {
      "slug": "win-back-day-30",
      "file": "templates/win-back-day-30.html",
      "text_file": "templates/win-back-day-30.txt",
      "klaviyo_name": "Tonamorph - Win-back - day 30",
      "subject": "What changed in Tonamorph",
      "preview_text": "Plus 2 extra morphs.",
      "kind": "flow",
      "flow": "Win-back",
      "step": 1,
      "trigger_metric": null,
      "trigger_segment": "Dormant 30d",
      "trigger_note": "Segment-triggered flows are UI-only (Klaviyo MCP reads flows, Windsor create_flow takes metric or list triggers). Exclude profiles with Refund Issued. The 2 bonus morphs must be granted before the flow goes live (see README, Known gaps).",
      "delay": "PT0S",
      "delay_label": "0 h",
      "filter": "Flow filter: no Refund Issued ever",
      "transactional": false,
      "utm_campaign": "win-back",
      "event_variables": [],
      "profile_variables": []
    },
    {
      "slug": "purchase-thank-you",
      "file": "templates/purchase-thank-you.html",
      "text_file": "templates/purchase-thank-you.txt",
      "klaviyo_name": "Tonamorph - Purchase - 0 h (transactional)",
      "subject": "Morphs added — three ways to use them well",
      "preview_text": "Receipt inside.",
      "kind": "flow",
      "flow": "Purchase",
      "step": 1,
      "trigger_metric": "Purchase Completed",
      "delay": "PT0S",
      "delay_label": "0 h",
      "filter": "Message marked transactional in the UI, smart sending off. The is_renewal split sends this same template on both branches; the +3 d workflow and +14 d NPS steps are not authored here",
      "transactional": true,
      "utm_campaign": "purchase",
      "event_variables": ["credits"],
      "profile_variables": []
    },
    {
      "slug": "launch-week",
      "file": "templates/launch-week.html",
      "text_file": "templates/launch-week.txt",
      "klaviyo_name": "Tonamorph - Campaign - Launch week",
      "subject": "Tonamorph is live. Any track, now an instrument.",
      "preview_text": "3 free morphs, no card. FL Studio, Ableton, Logic.",
      "kind": "campaign",
      "flow": null,
      "step": null,
      "trigger_metric": null,
      "audience": ["Tonamorph waitlist", "Tonamorph newsletter"],
      "delay": null,
      "delay_label": "campaign",
      "filter": "Campaign audience: the two lists above; exclude the Paying segment if it exists",
      "transactional": false,
      "utm_campaign": "launch-week",
      "event_variables": [],
      "profile_variables": []
    }
  ]
}
