# Tonamorph API (contract §2, §11). The key is sent as X-API-Key.
TONAMORPH_API_URL=https://api.tonamorph.com
TONAMORPH_API_KEY=tm_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local state and working files
GROWTH_DB_PATH=./growth.db
GROWTH_WORK_DIR=./work

# Source clips. Only rights-cleared audio may be used for advertising: each clip needs a
# manifest entry (<clip>.license.json beside it, or an entry in the folder's licences.json)
# naming its licence, or process_clip refuses it.
LICENSED_CLIPS_DIR=./licensed_clips
FMA_API_KEY=
FMA_API_URL=https://freemusicarchive.org/api/get

# ElevenLabs text-to-speech (v1, with timestamps)
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Rendering
REMOTION_DIR=./remotion
REMOTION_BROWSER_EXECUTABLE=
REMOTION_GL=
REMOTION_CONCURRENCY=2
FFMPEG_BIN=ffmpeg
FFMPEG_FONT_FILE=

# Meta Graph API (Instagram Reels + Facebook Page Reels)
META_GRAPH_API_URL=https://graph.facebook.com
META_UPLOAD_API_URL=https://rupload.facebook.com
META_API_VERSION=v21.0
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# TikTok Content Posting API
TIKTOK_API_URL=https://open.tiktokapis.com
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3 (OAuth access token with youtube.upload scope)
YOUTUBE_API_URL=https://www.googleapis.com
YOUTUBE_ACCESS_TOKEN=

# Credit guard for run_daily_batch. The batch reads GET /v1/me before every clip and stops
# rather than taking the balance below the floor or spending more than the budget.
# GROWTH_CREDIT_FLOOR=0 still prevents spending into a 402; raise it to reserve credits for
# work other than the batch. GROWTH_CREDIT_BUDGET empty = bounded by `count` and the floor.
GROWTH_CREDIT_FLOOR=0
GROWTH_CREDIT_BUDGET=

# Campaign attribution for the link in every published caption (utm_content is the content
# item id). GROWTH_REFERRAL_CODE is the affiliate code the checkout resolves (contract §12).
GROWTH_LANDING_URL=https://tonamorph.com
GROWTH_UTM_CAMPAIGN=ugc_shorts
GROWTH_UTM_MEDIUM=social
GROWTH_REFERRAL_CODE=

# Per-platform daily publish caps used by run_daily_batch
GROWTH_MAX_POSTS_PER_DAY_INSTAGRAM=5
GROWTH_MAX_POSTS_PER_DAY_FACEBOOK=5
GROWTH_MAX_POSTS_PER_DAY_TIKTOK=3
GROWTH_MAX_POSTS_PER_DAY_YOUTUBE=4
