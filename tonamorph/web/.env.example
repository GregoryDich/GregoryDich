# Copy to .env.local for local development. Every variable here is public (inlined into the
# browser bundle); never put the Supabase service-role key or any secret in this project.

# --- Brand (the product is being renamed: nothing in the code contains the name) -----------
NEXT_PUBLIC_PRODUCT_NAME=            # Product name shown everywhere (default: the current working name)
NEXT_PUBLIC_SITE_URL=https://example.com   # Canonical origin, no trailing slash; used for metadata, sitemap, email links
NEXT_PUBLIC_SUPPORT_EMAIL=           # Support address (default: support@<site host>)
NEXT_PUBLIC_PRIVACY_EMAIL=           # Privacy contact for the legal documents (default: support email)
NEXT_PUBLIC_LEGAL_EMAIL=             # Legal notices contact for the legal documents (default: support email)
NEXT_PUBLIC_COMPANY_LEGAL_NAME=      # Legal entity named in the Terms (default: product name)
NEXT_PUBLIC_COMPANY_ADDRESS=         # Registered address substituted into the legal documents
NEXT_PUBLIC_COMPANY_REG_ID=          # Company / sole-trader registration number for the legal documents
NEXT_PUBLIC_MERCHANT_OF_RECORD=Paddle   # Payment provider named as merchant of record
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-09-09   # ISO date the legal documents took effect ([[EFFECTIVE_DATE]] / [[EFFECTIVE_YEAR]])

# --- Supabase Auth (anon key only) ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co   # Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Public anon key; RLS protects everything it can reach

# --- Backend API (docs/API_CONTRACT.md) ----------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com   # Base URL of the FastAPI backend; unset = static pricing, no account data

# --- Billing --------------------------------------------------------------------------------
NEXT_PUBLIC_BILLING_PORTAL_URL=      # Customer portal link shown as "Manage subscription" on /account (optional)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=     # Paddle.js client-side token; unset = /checkout shows "not configured"
NEXT_PUBLIC_PADDLE_ENV=production    # "sandbox" while testing against the Paddle sandbox, otherwise "production"

# --- Marketing / analytics -----------------------------------------------------------------
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=      # Klaviyo public company id; script loads only after cookie consent (optional)

# --- Downloads ------------------------------------------------------------------------------
NEXT_PUBLIC_DOWNLOAD_BASE_URL=/downloads   # Where installers live: <base>/<version>/<slug>-<version>-macos-universal.pkg
